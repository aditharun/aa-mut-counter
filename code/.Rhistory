#single n, multiple k
n_vector <- seq(4, 60, 1)
grab_data <- function(n_vector, data, i){
errors <- lapply(n_vector, function(n) lapply(1:n, function(t) (pbinom((t-1), n, 0.5) - data$frac_functional_at_mix[i])^2) %>% unlist())
lapply(errors, function(x) c(min_error = min(x), k = which.min(x))) %>% do.call(rbind, .) %>% as_tibble() %>% mutate(n = n_vector) %>% mutate(mutant = data$mutant[i])
}
fit <- lapply(1:nrow(data), function(i) grab_data(n_vector, data, i)) %>% do.call(rbind, .) %>% as_tibble()
fit
fit %>% group_by(n) %>% summarize(sse = sum(min_error))
fit %>% group_by(n) %>% summarize(sse = sum(min_error), unique_k = length(unique(k)))
fit %>% group_by(n) %>% summarize(sse = sum(min_error), unique_k = length(unique(k)), n_mt = nrow(data))
fit %>% group_by(n) %>% summarize(sse = sum(min_error), unique_k = length(unique(k)), n_mt = nrow(data)) %>% mutate(aic = n_mt * log(sse/n_mt) + (2*unique_k))
fit %>% group_by(n) %>% summarize(sse = sum(min_error), unique_k = length(unique(k)), n_mt = nrow(data)) %>% mutate(aic = n_mt * log(sse/n_mt) + (2*unique_k)) %>% arrange(aic)
fit
fit %>% arrange(desc(n))
fit %>% group_by(n) %>% summarize(sse = sum(min_error), unique_k = length(unique(k)), n_mt = nrow(data)) %>% mutate(aic = unique_k*log(n_mt) - 2* log(sse))
