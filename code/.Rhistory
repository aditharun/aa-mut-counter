grab_data <- function(n_vector, data, i){
errors <- lapply(n_vector, function(n) lapply(1:n, function(t) (pbinom((t-1), n, 0.5) - data$frac_functional_at_mix[i])^2) %>% unlist())
lapply(errors, function(x) c(min(x), which.min(x))) %>% do.call(rbind, .) %>% as_tibble() %>% magrttr::set_colnames(c("min_error", "k"))
lapply(errors, function(x) c(min_error = min(x), k = which.min(x))) %>% do.call(rbind, .) %>% as_tibble() %>% mutate(n = n_vector) %>% mutate(mutant = data$mutant[i])
}
lapply(1:nrow(data), function(i) grab_data(n_vector, data, i))
